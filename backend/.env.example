# MongoDB Configuration
MONGO_URI=mongodb+srv://admin:password@cluster-name.mongodb.net/sem4-db?retryWrites=true&w=majority

# JWT Secret (Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=your_secure_jwt_secret_key_here_minimum_32_characters

# Server Configuration
PORT=5000
NODE_ENV=development

# Frontend URL (for CORS) - Optional, defaults to http://localhost:5173 in dev
FRONTEND_URL=http://localhost:5173

# Database Configuration - Optional
MONGO_DB_NAME=sem4-db
MONGO_TIMEOUT=5000

